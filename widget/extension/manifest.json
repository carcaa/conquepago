{
  "manifest_version": 3,
  "name": "¿Con qué pago?",
  "version": "0.1.0",
  "description": "Te dice con qué billetera o tarjeta conviene pagar en la tienda online donde estás.",
  "icons": { "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://carcaa.github.io/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://carcaa.github.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
